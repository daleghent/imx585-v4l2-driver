#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk
export DEB_VERSION_UPSTREAM

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	dtc -Wno-interrupts_property -Wno-unit_address_vs_reg -@ -I dts -O dtb -o debian/imx585.dtbo imx585-overlay.dts

override_dh_dkms:
	dh_dkms -V$(DEB_VERSION_UPSTREAM) -- dkms.conf
